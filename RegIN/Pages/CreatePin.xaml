<Page x:Class="RegIN.Pages.CreatePin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="CreatePin">

    <Grid Background="#EFEFEF">

        <materialDesign:Card Width="300"
                             Padding="15"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center">

            <StackPanel>

                <materialDesign:PackIcon Kind="Lock"
                                         Width="80"
                                         Height="80"
                                         Foreground="#673AB7"
                                         HorizontalAlignment="Center"
                                         Margin="0,10,0,20"/>

                <TextBlock Text="Create PIN code"
                           FontSize="24"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Create a 4-digit PIN for quick login"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,20"/>

                <TextBlock Text="Enter PIN code:"/>

                <PasswordBox x:Name="TbPin"
                             MaxLength="4"
                             FontSize="24"
                             Margin="0,5,0,15"/>

                <TextBlock Text="Confirm PIN code:"/>

                <PasswordBox x:Name="TbConfirmPin"
                             MaxLength="4"
                             FontSize="24"
                             Margin="0,5,0,15"/>

                <TextBlock x:Name="TNotification"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Button Content="Save PIN code"
                        Click="SavePin"
                        Margin="0,5"/>

                <Button Content="Skip"
                        Click="SkipPin"
                        Margin="0,5"/>

            </StackPanel>

        </materialDesign:Card>

    </Grid>

</Page>